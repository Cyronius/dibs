{
  "description": "dibs: lower Claude's priority at start, and hold back commands that would collide with another session's resources",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/dibs\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/dibs\" hook",
            "timeout": 600,
            "statusMessage": "Waiting for a shared resource (dibs)"
          }
        ]
      }
    ]
  }
}
